// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(cuid())
  singleton    String @unique @default("administrator")
  email        String @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  sessions     Session[]
  resets       PasswordReset[]
}

model Session {
  tokenHash String @id
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}

model PasswordReset {
  tokenHash String @id
  userId    String @unique
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model RateLimit {
  key       String @id
  attempts  Int @default(1)
  expiresAt DateTime
}

model Patient {
  id           String @id @default(cuid())
  name         String
  phone        String?
  age          Int?
  weightKg     Float?
  gender       String?
  address      String?
  identityKey  String? @unique
  createdAt    DateTime @default(now())
  appointments Appointment[]
  treatmentRecords TreatmentRecord[]
  prescriptions Prescription[]
  @@index([createdAt])
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Appointment {
  id        String @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  startsAt  DateTime
  durationMinutes Int @default(30)
  reason    String
  status    AppointmentStatus @default(SCHEDULED)
  createdAt DateTime @default(now())
  treatmentRecords TreatmentRecord[]
  prescriptions Prescription[]
  consultation Consultation?
  @@index([startsAt, status])
  @@index([patientId])
}

model Consultation {
  id                  String @id @default(cuid())
  appointmentId       String @unique
  appointment         Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  medicalHistory      String?
  presentingComplaints String?
  allergies           String?
  currentMedications  String?
  dentalHistory       String?
  clinicalFindings    String?
  toothNumbers        String?
  diagnosis           String?
  procedures          String?
  referralSpecialist  String?
  referralReason      String?
  referralInstructions String?
  patientConsent      Boolean @default(false)
  consentNotes        String?
  consentedAt         DateTime?
  updatedAt           DateTime @updatedAt
}

model ClinicSettings {
  singleton          String @id @default("clinic")
  clinicName         String @default("Rashid Clinic")
  logoDataUrl        String?
  address            String?
  phone              String?
  whatsapp           String?
  email              String?
  openingDays        String?
  openingHours       String?
  openingTime        String?
  closingTime        String?
  breakTimings       String?
  phcRegistrationNumber String?
  phcLicenseNumber   String?
  appointmentContact String?
  emergencyContact   String?
  facilities         String?
  updatedAt          DateTime @updatedAt
}

model DoctorProfile {
  singleton      String @id @default("doctor")
  fullName       String @default("Doctor")
  title          String @default("Dr.")
  qualifications String?
  specialization String?
  experiences    String?
  pmdcNumber     String?
  designation    String?
  signatureDataUrl String?
  updatedAt      DateTime @updatedAt
}

enum PrescriptionStatus {
  DRAFT
  FINALIZED
}

model TreatmentCatalog {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  records     TreatmentRecord[]
}

model MedicineCatalog {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@index([name])
}

model TreatmentRecord {
  id            String @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patientId     String
  patient       Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  treatmentId   String
  treatment     TreatmentCatalog @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  notes         String?
  createdAt     DateTime @default(now())
  @@index([appointmentId])
  @@index([patientId, createdAt])
}

model Prescription {
  id            String @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patientId     String
  patient       Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  notes         String?
  status        PrescriptionStatus @default(DRAFT)
  finalizedAt   DateTime?
  profileSnapshot String?
  followUpDate  DateTime?
  image1DataUrl String?
  image2DataUrl String?
  image3DataUrl String?
  imageWidthMm  Float @default(30)
  imageHeightMm Float @default(59.4)
  createdAt     DateTime @default(now())
  items         PrescriptionItem[]
  @@index([appointmentId])
  @@index([patientId, createdAt])
}

model PrescriptionItem {
  id             String @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine       String
  strength       String @default("")
  dosage         String
  route          String @default("Oral")
  frequency      String
  timing         String
  duration       String
  instructions   String
  quantity       String @default("")
  sortOrder      Int @default(0)
  @@index([prescriptionId, sortOrder])
}
