# Neon pooled URL (its hostname normally contains `-pooler`) for application traffic.
DATABASE_URL="postgresql://USER:PASSWORD@EP_NAME-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@EP_NAME-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Neon direct URL (same endpoint without `-pooler`) for Prisma migrations.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@EP_NAME.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Optional: a separate Neon branch/database used only by automated tests.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST_ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"
APP_URL="http://localhost:3000"
# Development only: emails are written privately to .local/mail/password-reset.txt
MAIL_DELIVERY="file"
# Production: use MAIL_DELIVERY="resend", HTTPS APP_URL, and a verified sender.
RESEND_API_KEY=""
MAIL_FROM="Rashid Clinic <noreply@your-domain.com>"
# Used only by npm run db:seed. Never exposed to the browser.
ADMIN_EMAIL="admin@rashidclinic.local"
ADMIN_NAME="Clinic Administrator"
# Development: omit to choose a password through .local/setup-link.txt.
# Production: supply a strong password during setup, then remove it from the environment.
# ADMIN_PASSWORD=""
